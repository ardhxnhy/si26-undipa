<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="100%" height="100%">
  <!-- Monochrome Sistem Informasi Emblem -->
  <circle cx="100" cy="100" r="92" fill="none" stroke="#FFFFFF" stroke-width="3" opacity="0.9"/>
  <circle cx="100" cy="100" r="82" fill="none" stroke="#666666" stroke-width="1.5" stroke-dasharray="4 3"/>
  <circle cx="100" cy="100" r="72" fill="#0A0A0A" stroke="#333333" stroke-width="1"/>
  
  <!-- Modern Tech / Information Nodes -->
  <!-- Top Node -->
  <circle cx="100" cy="62" r="7" fill="#FFFFFF"/>
  <!-- Left Bottom Node -->
  <circle cx="70" cy="115" r="7" fill="#FFFFFF"/>
  <!-- Right Bottom Node -->
  <circle cx="130" cy="115" r="7" fill="#FFFFFF"/>
  <!-- Center Hub Node -->
  <circle cx="100" cy="95" r="10" fill="#1A1A1A" stroke="#FFFFFF" stroke-width="2"/>
  <circle cx="100" cy="95" r="4" fill="#FFFFFF"/>
  
  <!-- Interconnecting Circuit Lines -->
  <line x1="100" y1="62" x2="100" y2="85" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round"/>
  <line x1="100" y1="95" x2="70" y2="115" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round"/>
  <line x1="100" y1="95" x2="130" y2="115" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round"/>
  <line x1="70" y1="115" x2="130" y2="115" stroke="#FFFFFF" stroke-width="1.5" stroke-dasharray="3 3"/>

  <!-- Typography -->
  <text x="100" y="138" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" font-size="10" font-weight="700" fill="#FFFFFF" text-anchor="middle" letter-spacing="2">SISTEM INFORMASI</text>
  <text x="100" y="165" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" font-size="8" font-weight="600" fill="#888888" text-anchor="middle" letter-spacing="2">SI '26</text>
</svg>
